{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:threadline:graph:1.0",
  "title": "Threadline Graph Contract 1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "source",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "treeHash"
      ],
      "properties": {
        "treeHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "publisher": {
          "type": "string"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "maxItems": 20000
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "maxItems": 100000
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "recordedAt": {
      "type": "string"
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "kind": {
          "enum": [
            "module",
            "file",
            "symbol",
            "feature",
            "document"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]+$"
        },
        "parent": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "type": "string",
          "maxLength": 10000
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "maxItems": 1000
        }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "contains",
            "declares",
            "imports",
            "references",
            "implements",
            "documents",
            "calls",
            "depends_on"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "maxItems": 1000
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]+$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "method": {
          "type": "string",
          "maxLength": 200
        },
        "status": {
          "enum": [
            "observed",
            "lexical",
            "interpretation",
            "stale",
            "unverified"
          ]
        },
        "reference": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
